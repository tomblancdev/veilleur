#!/bin/sh
# squat-veilleur — the ONLY thing Le Veilleur's ssh key may run on a node
# (forced command in root's authorized_keys):
#
#   signal <name>     ask a named question   -> exit code IS the answer
#   state  <target>   is it up?              -> 0 = up
#   up     <target>   raise it
#   down   <target>   put it down
#   list              what this node will accept (names only)
#
# THE NODE HOLDS THE COMMANDS; LE VEILLEUR ONLY NAMES THEM. Every name is
# looked up in this node's own table (/etc/veilleur/commands.conf, rendered by
# ansible) — never interpolated into a shell. So the watchman may ask for
# `signal console_in_use`; it cannot ask for `rm -rf /`, and it cannot touch a
# target this node was not given. A 24/7 node is simply not given a `down:`
# entry for itself.
#
# Reference copy: github.com/tomblancdev/veilleur, deploy/proxmox/.
set -eu

CONF=${VEILLEUR_COMMANDS:-/etc/veilleur/commands.conf}
[ -r "$CONF" ] || { echo "squat-veilleur: no command table at $CONF" >&2; exit 3; }

deny() { logger -t squat-veilleur "DENIED: $*"; echo "squat-veilleur: refused: $*" >&2; exit 3; }

# a name is a bare identifier or nothing at all
check_name() {
	case "$1" in
		'' ) deny "missing name" ;;
		*[!A-Za-z0-9_.-]* ) deny "bad name: $1" ;;
	esac
}

# look up "<kind>:<name>" and print its command, or nothing
lookup() {
	# the value may contain anything, including '=' and pipes: take
	# everything after the FIRST '='
	sed -n "s/^$1:$2=//p" "$CONF" | head -n1
}

run_named() {
	kind=$1; name=$2
	check_name "$name"
	cmd=$(lookup "$kind" "$name")
	[ -n "$cmd" ] || deny "this node has no '$kind' entry for '$name'"
	# the command is the NODE's own, from its own file
	sh -c "$cmd"
}

set -- ${SSH_ORIGINAL_COMMAND:-$*}
verb=${1:-}
case "$verb" in
	signal)
		run_named signal "${2:-}"
		;;
	state)
		run_named state "${2:-}"
		;;
	up|down)
		name=${2:-}
		check_name "$name"
		cmd=$(lookup "$verb" "$name")
		[ -n "$cmd" ] || deny "this node may not '$verb' '$name'"
		logger -t squat-veilleur "$verb $name"
		sh -c "$cmd"
		;;
	list)
		# names only — never the commands themselves
		sed -n 's/^\([a-z]*\):\([A-Za-z0-9_.-]*\)=.*/\1 \2/p' "$CONF" | sort
		;;
	*)
		echo "squat-veilleur: signal <name> | state <target> | up <target> | down <target> | list" >&2
		exit 3
		;;
esac
